# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.egg-info/

# Local env (all real env files stay out of git; only *.example is tracked)
.env
.env.*.local
.env.local

.env.staging.bak-*
.env*
*.env.bak
# An example file is committed on purpose: it names the variables a
# deployment needs without carrying their values, so the broad rule above
# must not swallow it (a protected secret and a blinded reader are two bugs).
!.env*.example

# Logs
*.log
logs/

# Build outputs
dist/
dist-test-render/
build/
.cache/

# IDE
.vscode/
.idea/
*.iml

# Test artifacts
# Temporary files
*.tmp
*.temp
*.bak-*

# Virtual environments
.venv/
venv/

