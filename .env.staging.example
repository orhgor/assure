# Copy to .env.staging on staging EC2 (/home/ubuntu/assure/.env.staging).
# Never commit real keys.

# Models: Amazon Bedrock (decision 2026-10-01; the OpenRouter free stack and
# ASSURE_USE_FREE_MODELS were removed). Opus 5.5 reads the uploaded file,
# Sonnet 5.5 answers every other prompt. The instance role signs the calls
# (bedrock:InvokeModel*); no provider key.
ASSURE_LLM_BACKEND=bedrock
PARSER_BACKEND=bedrock
AWS_DEFAULT_REGION=us-east-1
# ASSURE_BEDROCK_MODEL_PARSE=anthropic.claude-opus-5-5
# ASSURE_BEDROCK_MODEL_DRAFT=anthropic.claude-sonnet-5-5

# Infrastructure (docker-compose.yml + docker-compose.staging.yml)
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/0
PEM_SECRET_KEY=
PARSE_ASYNC=1
# ASSURE_S3_BUCKET=assure-staging-objects
ASSURE_RUN_TIMEOUT_SECONDS=90
PEM_TIMEOUT_SECONDS=180

# Optional hosted keys, only for an explicit target_ai override (gemini/…, groq/…).
# Groq chat from AWS IPs is often Cloudflare-blocked (403/1010).
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Grounding retrieval (2C): the Brave Search key the fetch path reads. Empty
# here means the search leg has no key and the drawer offers the upload button
# instead; which hosts may be fetched is config/authoritative_domains.yaml.
BRAVE_API_KEY=

# Who is an admin, as Clerk user ids (comma or semicolon separated). Every
# other signed-in user is an underwriter; empty means nobody is an admin.
ASSURE_ADMIN_USER_IDS=

# Projects whose compiled document is a pinned artifact: a cold compile on one
# of these is refused unless the request carries force=true, so a verification
# pass cannot move the revision it is pinned to. Left commented because the
# default is in the code - setting it to empty would disable the guard.
# ASSURE_FROZEN_PROJECTS=
