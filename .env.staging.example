# Copy to .env.staging on staging EC2 (/home/ubuntu/assure/.env.staging).
# Never commit real keys.

# Free model stack for staging development (Difference Engine)
ASSURE_USE_FREE_MODELS=1

# Lean native stack: no SQS/Celery worker (sync runs only)
CELERY_BROKER_URL=
CELERY_TASK_ALWAYS_EAGER=1
ASSURE_RUN_TIMEOUT_SECONDS=90
PEM_TIMEOUT_SECONDS=180

# Free stack — no billing required
# Default compare pair uses OpenRouter free models (works from AWS EC2).
# Groq is optional: chat from AWS IPs is often Cloudflare-blocked (403/1010).
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_HTTP_REFERER=https://staging.getassureai.com
OPENROUTER_APP_TITLE=Assure AI

# Paid path only (production / ASSURE_USE_FREE_MODELS=0)
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
