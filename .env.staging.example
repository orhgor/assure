# Copy to .env.staging on staging EC2 (/home/ubuntu/assure/.env.staging).
# Never commit real keys.

# Free model stack for staging development (Difference Engine)
ASSURE_USE_FREE_MODELS=1

# Required for the free stack
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional third opinion (Groq) — leave blank to disable alternate pair
GROQ_API_KEY=
