# Native Assure service — install with scripts/aws/install-lean-service.sh
# Cloudflare Tunnel (cloudflared) forwards app.getassureai.com → http://127.0.0.1:8765

[Unit]
Description=Assure AI Lean Python Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/assure
Environment=PYTHONUNBUFFERED=1
Environment=ASSURE_DAEMON=1
Environment=ASSURE_HOST=127.0.0.1
Environment=PORT=8765
Environment=ASSURE_QUIET_START=1
EnvironmentFile=-/home/ubuntu/assure/.env.staging
Environment=ASSURE_ENV=staging
Environment=ENVIRONMENT=staging
Environment=ASSURE_USE_FREE_MODELS=1
Environment=CELERY_BROKER_URL=
Environment=CELERY_TASK_ALWAYS_EAGER=1
Environment=ASSURE_RUN_TIMEOUT_SECONDS=90
Environment=PEM_TIMEOUT_SECONDS=180
Environment=DATABASE_PATH=/home/ubuntu/assure/data-staging/history.sqlite
ExecStart=/home/ubuntu/assure/.venv/bin/python prompt_matrix/app.py
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
