# syntax=docker/dockerfile:1
# Optional worker variant: the app image plus Docling.
#
# The default parse worker IS the app image (the assure-worker service in
# docker-compose.yml and the ECS worker service run `celery ... worker -Q parse,default` on it): node,
# jdf-cli with tesseract OCR, Z3 and Textract/S3 clients are all there. This
# file exists only for a deployment that wants Docling's layout model as an
# additional extractor (USE_DOCLING=1). Docling pulls a CUDA toolkit and
# multi-GB NVIDIA libraries that a Graviton box cannot use, so it never ships
# in the web image.
#
#   docker build -f Dockerfile.worker --build-arg BASE_IMAGE=ghcr.io/<owner>/assure-app:<sha> \
#     -t ghcr.io/<owner>/assure-worker:<sha> .
ARG BASE_IMAGE=ghcr.io/orhgor/assure-app:latest

FROM python:3.11-slim AS mlbuilder
WORKDIR /app
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
COPY requirements-worker.txt .
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && pip install --upgrade pip \
    && pip install --prefer-binary -r requirements-worker.txt \
    && apt-get purge -y gcc \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

FROM ${BASE_IMAGE} AS runtime
COPY --from=mlbuilder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=mlbuilder /usr/local/bin /usr/local/bin

ARG BUILD_SHA=unknown
ARG BUILD_BRANCH=unknown
ARG BUILD_TIME=unknown
ENV ASSURE_BUILD_SHA=${BUILD_SHA} \
    ASSURE_BUILD_BRANCH=${BUILD_BRANCH} \
    ASSURE_BUILD_TIME=${BUILD_TIME} \
    USE_DOCLING=1

CMD ["sh", "-c", "exec celery -A prompt_matrix.celery_app:celery_app worker --loglevel=info --concurrency=${WORKER_CONCURRENCY:-2} --prefetch-multiplier=1 -Q parse,default"]
