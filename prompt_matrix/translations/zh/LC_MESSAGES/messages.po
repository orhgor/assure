# answer.copy
#: prompt_matrix/templates/index.html:124
msgid "Quick Answer"
msgstr "快速回答"

#: prompt_matrix/templates/index.html:125
msgid "Fastest. One model answers."
msgstr "最快。一个模型作答。"

#: prompt_matrix/templates/index.html:129
msgid "Compare & Validate"
msgstr "比较并核对"

#: prompt_matrix/templates/index.html:130
msgid "Multiple models check each other. We show agreement and disagreement."
msgstr "多个模型互相核对。我们标出一致和分歧。"

#: prompt_matrix/templates/index.html:134
msgid "Refine & Verify"
msgstr "润色并核验"

#: prompt_matrix/templates/index.html:135
msgid "We draft, critique, and rewrite your answer."
msgstr "我们起草、批评，再改写你的回答。"

#: prompt_matrix/templates/index.html:137
msgid "Tip: \"Compare & Validate\" works best for most questions."
msgstr "提示：大多数问题适合「比较并核对」。"

# recipe.1
#: prompt_matrix/templates/index.html:140
msgid "Draft. One model writes a first pass."
msgstr "Draft. One model writes a first pass."

# recipe.2
#: prompt_matrix/templates/index.html:141
msgid "Critique. A critic only attacks that pass. It does not write a new essay."
msgstr "Critique. A critic only attacks that pass. It does not write a new essay."

# recipe.3
#: prompt_matrix/templates/index.html:142
msgid "Rewrite. The same model revises using the critique. That is what you keep."
msgstr "Rewrite. The same model revises using the critique. That is what you keep."

#: prompt_matrix/templates/index.html:144
msgid ""
"Turn on Get my answer. Click once. Wait through three calls. Read the "
"final on the right."
msgstr "打开「给我答案」。点一次。等三次调用结束。在右侧看终稿。"

#: prompt_matrix/templates/index.html:145
msgid "What should the critique look for?"
msgstr "What should the critique look for?"

#: prompt_matrix/templates/index.html:147
msgid "Unsupported claims, missing caveats, keep / revise / reject."
msgstr ""

#: prompt_matrix/templates/index.html:148
msgid "Who critiques?"
msgstr "Who critiques?"

