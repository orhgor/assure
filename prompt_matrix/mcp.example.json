{
  "mcpServers": {
    "pem": {
      "command": "/absolute/path/to/venv/bin/python",
      "args": ["-u", "-m", "prompt_matrix.mcp_server"],
      "cwd": "/absolute/path/to/this/repo",
      "env": {
        "PYTHONPATH": "/absolute/path/to/this/repo",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
