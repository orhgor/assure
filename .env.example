# Copy to the repo root .env. Never commit real keys.

# ---- Infrastructure (required) -------------------------------------------
# PostgreSQL is the only database. docker compose -f docker-compose.dev.yml up -d
# provides this one locally; on AWS it is RDS / Aurora.
DATABASE_URL=postgresql://assure:assure@localhost:5432/assure
# Redis: Celery broker + results, rate-limit counters, debounce locks.
# Required when ENVIRONMENT=production|staging (ElastiCache on AWS).
REDIS_URL=redis://localhost:6379/0
# Instance-local scratch (upload staging when no S3, OMP mirror, logs).
ASSURE_DATA_DIR=./data
# ---- AWS / S3 (real bucket, also when running locally) --------------------
# Credential resolution order: these variables → credentials entered on the
# Sources panel (stored encrypted in PostgreSQL) → the machine's IAM role
# (EC2 instance profile / ECS task role). On AWS leave the two keys empty and
# use the role (scripts/aws/attach-runtime-role.sh, infra/terraform).
# Locally, an IAM user with s3:PutObject/GetObject/DeleteObject/ListBucket on
# the bucket (plus textract:* if Textract fallback is wanted) is enough.
ASSURE_S3_BUCKET=
ASSURE_S3_PREFIX=assure/
AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Without ASSURE_S3_BUCKET uploads stay under ${ASSURE_DATA_DIR}/objects and the
# Sources panel shows a warning with a "Connect IAM" form.
# Parsing: 1 = queued to the Celery worker (default with a broker), 0 = inline.
# PARSE_ASYNC=1
# Largest single upload in MB (default 25).
# MAX_UPLOAD_SIZE_MB=25
# Scans: jdf-ocr (tesseract, local, free — default) or textract (per-page fee).
# Textract hard cap per calendar month (USD, list price, enforced before each call;
# default 100) and API: detect (0.0015 USD/page, default) | analyze (0.065 USD/page).
# ASSURE_TEXTRACT_MONTHLY_USD_CAP=100
# ASSURE_TEXTRACT_MODE=detect
# PARSER_BACKEND=auto            # auto: text layer → jdf-cli, scans → PARSER_SCAN_BACKEND; textract: EVERY PDF and image
#                                 # goes to Amazon Textract (needs AWS credentials); openrouter: EVERY page is rendered and
#                                 # read by ASSURE_OPENROUTER_MODEL_PARSE (a multimodal model, e.g. anthropic/claude-opus-5.5).
#                                 # Either hosted reader's output is saved as a JDF document and the pipeline continues on it
# PARSER_SCAN_BACKEND=jdf-ocr
# JDF_OCR=tesseract
# Session signing; required on servers (same value on every replica).
# PEM_SECRET_KEY=
# Reverse-proxy hops to trust for X-Forwarded-* (ALB/Cloudflare = 1).
# PROXY_FIX_HOPS=1

# ---- Accounts (docs/auth.md) -------------------------------------------------
# ASSURE_AUTH_MODE: local (accounts in PostgreSQL, roles owner / compliance_reviewer /
#   reviewer / intake / auditor; every /api call needs a signed-in user) | clerk
#   (hosted sign-in, cloud) | off (no accounts, laptop / tests). Unset: local when
#   ASSURE_BOOTSTRAP_TOKEN is set or an owner exists, clerk when Clerk keys are set
#   and there are no local users, else off.
# ASSURE_BOOTSTRAP_TOKEN: one-time token the first-run owner screen asks for
#   (scripts/gen-env.sh generates and prints it). Refused once any account exists.
# ASSURE_SESSION_HOURS: idle lifetime of a sign-in (default 12).
# ASSURE_PUBLIC_URL: origin used in invitation e-mails (the gate's address), e.g.
#   https://assure.example.com; empty = the requesting origin.
# ASSURE_AUTH_MODE=
# ASSURE_BOOTSTRAP_TOKEN=
# ASSURE_SESSION_HOURS=12
# ASSURE_PUBLIC_URL=

# ---- Models ------------------------------------------------------------------
# Default on every compose target (laptop and EC2): every LLM call (compile,
# locks, entailment, Red-Hat, surgical edit, Compare) goes to the `ollama`
# compose service; `ollama-pull` downloads the two models on first start. No
# provider key. Staging/production overlays set ASSURE_LLM_BACKEND= (empty) and
# use the cloud policies with the keys below (COMPOSE_PROFILES=local-llm brings
# the ollama pair back there).
# ASSURE_LLM_BACKEND=              # empty: OPENROUTER_API_KEY set → openrouter, else ollama. Explicit: ollama | bedrock | openrouter | cloud
# OpenRouter, one hosted model per stage (defaults = the user's table, 2026-09-25):
# OPENROUTER_API_KEY=sk-or-...
# ASSURE_OPENROUTER_MODEL_PARSE=amazon/nova-lite-v1
# ASSURE_OPENROUTER_MODEL_DRAFT=meta-llama/llama-3.3-70b-instruct
# ASSURE_OPENROUTER_MODEL_ANCHOR=cohere/command-r7b-12-2024
# ASSURE_OPENROUTER_MODEL_EVIDENCE=mistralai/mistral-small-24b-instruct-2501
# ASSURE_OPENROUTER_MODEL_EDIT=mistralai/mistral-small-24b-instruct-2501
# ASSURE_OPENROUTER_MODEL_REDHAT=meta-llama/llama-3.3-70b-instruct
# ASSURE_OPENROUTER_MODEL_COMPARE=mistralai/mistral-small-24b-instruct-2501
# Bedrock, per task class (bare anthropic.* ids get the region's eu./us. inference-profile prefix):
# ASSURE_BEDROCK_MODEL_DRAFT=anthropic.claude-sonnet-5      # compile, deep synthesis, summarise, surgical edit
# ASSURE_BEDROCK_MODEL_ANALYSIS=anthropic.claude-opus-5     # entailment, Red-Hat, macro audit, field extraction, locks
# ASSURE_BEDROCK_MODEL_B=anthropic.claude-opus-5            # Compare's second column
# ASSURE_BEDROCK_MODEL=                                     # legacy: one id for draft + analysis
# ASSURE_OLLAMA_MODEL=qwen2.5:1.5b          # fallback for every stage
# ASSURE_OLLAMA_MODEL_PARSE=qwen2.5:7b      # Parsing (field extraction)
# ASSURE_OLLAMA_MODEL_DRAFT=qwen2.5:14b     # Prompt Compile (drafting)
# ASSURE_OLLAMA_MODEL_REDHAT=qwen2.5:14b    # Red-Hat (critique / compliance)
# ASSURE_OLLAMA_MODEL_EVIDENCE=qwen2.5:7b   # Evidence (claims validation)
# ASSURE_OLLAMA_MODEL_COMPARE=gemma3:27b    # Compare (2nd column); ASSURE_OLLAMA_MODEL_B is the old name
# Vision (Parsure picture pages, services/vision): one multimodal model per backend. The
# picture goes to the model as an image part; the answer is facts beside the report, never
# fields. Ollama: qwen2.5vl:3b is NOT pulled by ollama-pull, so on the local backend vision
# stays off until this variable is set (or PARSURE_VISION=1). OpenRouter/Bedrock defaults are
# multimodal and count as configured.
# ASSURE_OLLAMA_MODEL_VISION=qwen2.5vl:3b
# ASSURE_OPENROUTER_MODEL_VISION=amazon/nova-lite-v1
# ASSURE_BEDROCK_MODEL_VISION=anthropic.claude-sonnet-5
# OLLAMA_CONTEXT_LENGTH=8192      # ollama container context window
# OLLAMA_API_BASE=http://127.0.0.1:11434   # venv on the host; compose sets http://ollama:11434

# Model providers (Send). Swarm reviewer and documenter are Claude.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
# Required for identity-linked Anthropic keys (Claude Console → Settings → Workspaces).
# ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# KIMI_API_KEY=

# Clerk (test)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Fernet key for encrypted API-key sync. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Supabase (new Console names first; older names still work)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# cloud = Clerk + billing when those keys exist. self-hosted skips all of it.
# ASSURE_EDITION=cloud
# ASSURE_EDITION=self-hosted

# Plausible Stats API (server-side only — browser embed needs no API key)
# PLAUSIBLE_API_KEY=

# Optional Sentry (local dev — use SENTRY_ENABLED=1 to load browser bundle)
# SENTRY_DSN=
# SENTRY_BROWSER_DSN=
# SENTRY_AUTH_TOKEN=   # sntrys_* — CLI/CI only; not for SDK init

# Tester feedback is stored in SQLite and listed at /backstage. Email is off unless FEEDBACK_SEND_EMAIL=1
# FEEDBACK_SEND_EMAIL=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=notifications@getassureai.com
# FEEDBACK_EMAIL=feedback@getassureai.com

# GitHub Actions included minutes (shown on /backstage). Account cap is 3000.
# GITHUB_ACTIONS_MINUTE_LIMIT=3000
# GITHUB_ACTIONS_MINUTES_USED=
# GITHUB_BILLING_TOKEN=
# GITHUB_BILLING_OWNER=orhgor
# Parsure: offer the fields the label pass left empty to the configured model, accepting
# only values re-found verbatim in the page text (services/llm_extraction). 0 disables.
# PARSURE_LLM_EXTRACTION=1
# Parsure: describe picture pages (phone photo, screenshot, image upload, pages flagged photo)
# with the backend's vision model (services/vision). Unset = on when a vision model is
# configured for the backend (see ASSURE_*_MODEL_VISION); 1 forces on, 0 off. A poor picture
# (measured: too small, or blurry and low-contrast) is not sent. Bounds: pages per document,
# seconds per model call.
# PARSURE_VISION=
# PARSURE_VISION_MAX_PAGES=4
# PARSURE_VISION_TIMEOUT_S=45

# Parsure schema registry (docs/parsure-schemas.md): extra directories of
# parsure-schema-v1 JSON files, os.pathsep-separated, read after the shipped
# prompt_matrix/schemas/. A bad file is skipped with a logged reason.
# ASSURE_SCHEMA_DIR=/etc/assure/schemas
