# Copy to the repo root as .env (EC2: next to docker-compose.yml) and fill in
# the empty values. Never commit .env. Everything below "optional" can stay as is.
#
# Fill these in:  AWS_BEARER_TOKEN_BEDROCK, SHELL_ACCESS_KEY, POSTGRES_PASSWORD,
# PEM_SECRET_KEY, ENCRYPTION_KEY, and (for S3) ASSURE_S3_BUCKET + AWS keys.

# ---- models: Amazon Bedrock (user decision 2026-10-01) ----------------------------
# Every uploaded PDF/image goes straight to Claude Opus 5.5 (pages as images,
# printed + handwriting); its analysis is saved and drawn on the page. No jdf-cli,
# no tesseract, no Textract under PARSER_BACKEND=bedrock.
# Every other prompt (draft, Red-Hat, field labels, edit, Compare): Sonnet 5.5.
# Bare ids; the us./eu. inference-profile prefix is added from ASSURE_BEDROCK_REGION.
ASSURE_LLM_BACKEND=bedrock
PARSER_BACKEND=bedrock
ASSURE_BEDROCK_REGION=us-east-1
# Bedrock API key (bearer token) — the only Bedrock credential, no IAM needed.
AWS_BEARER_TOKEN_BEDROCK=
ASSURE_BEDROCK_MODEL_PARSE=anthropic.claude-opus-5-5
ASSURE_BEDROCK_MODEL_DRAFT=anthropic.claude-sonnet-5-5
ASSURE_BEDROCK_MODEL_ANALYSIS=anthropic.claude-sonnet-5-5
ASSURE_BEDROCK_MODEL_B=anthropic.claude-sonnet-5-5
ASSURE_LLM_PARSE_PAGES_PER_REQUEST=8
ASSURE_LLM_PARSE_CONCURRENCY=4
ASSURE_LLM_PARSE_TIMEOUT_S=600

# ---- shell (the workbench UI, prototype/dev-server.py) -------------------------
SHELL_BIND=0.0.0.0
SHELL_PORT=80
SHELL_ACCESS_KEY=                 # gate password of the shell
APP_BIND=127.0.0.1
PORT=8765

# ---- secrets (scripts/gen-env.sh generates them) -------------------------------
POSTGRES_PASSWORD=
PEM_SECRET_KEY=                   # session signing, same value on every replica
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- AWS S3 (originals, analysis.json) — not used for Bedrock ---------------------
# Empty keys = the machine's IAM role (EC2 instance profile).
# Without ASSURE_S3_BUCKET uploads stay under ${ASSURE_DATA_DIR}/objects.
ASSURE_S3_BUCKET=
ASSURE_S3_PREFIX=assure/
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- infrastructure ------------------------------------------------------------
# docker compose sets these for its own postgres/redis containers; fill them only
# for a venv run or an external RDS/ElastiCache.
DATABASE_URL=postgresql://assure:assure@localhost:5432/assure
REDIS_URL=redis://localhost:6379/0
ASSURE_DATA_DIR=./data

# ---- runtime flags --------------------------------------------------------------
ENVIRONMENT=production
ASSURE_ENV=production
PROXY_FIX_HOPS=1                  # reverse-proxy hops trusted for X-Forwarded-*
ASSURE_REQUIRE_LOGIN=false
ASSURE_CLERK_ONLY=0
WTF_CSRF_ENABLED=0
PARSE_ASYNC=1                     # 1 = parse on the Celery worker, 0 = inline
SUBSTRATE_ASYNC_UPLOAD=1
ASSURE_MAX_PAGES=200
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
WORKER_CONCURRENCY=2
# MAX_UPLOAD_SIZE_MB=25

# =================================== optional ===================================

# ---- Accounts (docs/auth.md) -------------------------------------------------
# ASSURE_AUTH_MODE: local (accounts in PostgreSQL, roles owner / compliance_reviewer /
#   reviewer / intake / auditor; every /api call needs a signed-in user) | clerk
#   (hosted sign-in, cloud) | off (no accounts, laptop / tests). Unset: local when
#   ASSURE_BOOTSTRAP_TOKEN is set or an owner exists, clerk when Clerk keys are set
#   and there are no local users, else off.
# ASSURE_BOOTSTRAP_TOKEN: one-time token the first-run owner screen asks for
#   (scripts/gen-env.sh generates and prints it). Refused once any account exists.
# ASSURE_SESSION_HOURS: idle lifetime of a sign-in (default 12).
# ASSURE_PUBLIC_URL: origin used in invitation e-mails (the gate's address), e.g.
#   https://assure.example.com; empty = the requesting origin.
# ASSURE_AUTH_MODE=
# ASSURE_BOOTSTRAP_TOKEN=
# ASSURE_SESSION_HOURS=12
# ASSURE_PUBLIC_URL=

# ---- Models ------------------------------------------------------------------
# User decision 2026-10-01: OpenRouter is removed; every LLM call goes to Amazon
# Bedrock with the API key AWS_BEARER_TOKEN_BEDROCK (no IAM needed for Bedrock). The document read runs on Claude Opus 5.5, every other
# prompt (compile, locks, entailment, Red-Hat, surgical edit, Compare) on Claude
# Sonnet 5.5. ASSURE_LLM_BACKEND=ollama is the explicit local option: every call
# goes to the `ollama` compose service, which ollama-pull fills on first start.
# ASSURE_LLM_BACKEND=bedrock        # bedrock (default) | ollama
# ASSURE_BEDROCK_REGION=us-east-1   # where Bedrock is called (us. profiles); defaults to AWS_DEFAULT_REGION. S3 keeps its own region
# AWS_BEARER_TOKEN_BEDROCK=          # Bedrock API key (bearer token): the Bedrock credential, no IAM needed; AWS keys/role then serve S3 only
# Bedrock ids (bare anthropic.* ids get the region's us./eu. inference-profile prefix):
# ASSURE_BEDROCK_MODEL_PARSE=anthropic.claude-opus-5-5       # the document read
# ASSURE_BEDROCK_MODEL_DRAFT=anthropic.claude-sonnet-5-5     # compile, deep synthesis, summarise, surgical edit
# ASSURE_BEDROCK_MODEL_ANALYSIS=anthropic.claude-sonnet-5-5  # entailment, Red-Hat, macro audit, field extraction, locks
# ASSURE_BEDROCK_MODEL_B=anthropic.claude-sonnet-5-5         # Compare's second column
# ASSURE_BEDROCK_MODEL=                                      # one id for draft + analysis
# ASSURE_OLLAMA_MODEL=qwen2.5:1.5b          # fallback for every stage
# ASSURE_OLLAMA_MODEL_PARSE=qwen2.5:7b      # Parsing (field extraction)
# ASSURE_OLLAMA_MODEL_DRAFT=qwen2.5:14b     # Prompt Compile (drafting)
# ASSURE_OLLAMA_MODEL_REDHAT=qwen2.5:14b    # Red-Hat (critique / compliance)
# ASSURE_OLLAMA_MODEL_EVIDENCE=qwen2.5:7b   # Evidence (claims validation)
# ASSURE_OLLAMA_MODEL_COMPARE=gemma3:27b    # Compare (2nd column); ASSURE_OLLAMA_MODEL_B is the old name
# Vision (Parsure picture pages, services/vision): one multimodal model per backend. The
# picture goes to the model as an image part; the answer is facts beside the report, never
# fields. Ollama: qwen2.5vl:3b is NOT pulled by ollama-pull, so on the local backend vision
# stays off until this variable is set (or PARSURE_VISION=1). The Bedrock default (Sonnet 5.5)
# is multimodal and counts as configured.
# ASSURE_OLLAMA_MODEL_VISION=qwen2.5vl:3b
# ASSURE_BEDROCK_MODEL_VISION=anthropic.claude-sonnet-5-5
# OLLAMA_CONTEXT_LENGTH=8192      # ollama container context window
# OLLAMA_API_BASE=http://127.0.0.1:11434   # venv on the host; compose sets http://ollama:11434

# Model providers (Send). Swarm reviewer and documenter are Claude.
# ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
# Required for identity-linked Anthropic keys (Claude Console → Settings → Workspaces).
# ANTHROPIC_WORKSPACE_ID=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# KIMI_API_KEY=

# Clerk (test)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (new Console names first; older names still work)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# cloud = Clerk + billing when those keys exist. self-hosted skips all of it.
# ASSURE_EDITION=cloud
# ASSURE_EDITION=self-hosted

# Plausible Stats API (server-side only — browser embed needs no API key)
# PLAUSIBLE_API_KEY=

# Optional Sentry (local dev — use SENTRY_ENABLED=1 to load browser bundle)
# SENTRY_DSN=
# SENTRY_BROWSER_DSN=
# SENTRY_AUTH_TOKEN=   # sntrys_* — CLI/CI only; not for SDK init

# Tester feedback is stored in SQLite and listed at /backstage. Email is off unless FEEDBACK_SEND_EMAIL=1
# FEEDBACK_SEND_EMAIL=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=notifications@getassureai.com
# FEEDBACK_EMAIL=feedback@getassureai.com

# GitHub Actions included minutes (shown on /backstage). Account cap is 3000.
# GITHUB_ACTIONS_MINUTE_LIMIT=3000
# GITHUB_ACTIONS_MINUTES_USED=
# GITHUB_BILLING_TOKEN=
# GITHUB_BILLING_OWNER=orhgor
# Parsure: offer the fields the label pass left empty to the configured model, accepting
# only values re-found verbatim in the page text (services/llm_extraction). 0 disables.
# PARSURE_LLM_EXTRACTION=1
# Parsure: describe picture pages (phone photo, screenshot, image upload, pages flagged photo)
# with the backend's vision model (services/vision). Unset = on when a vision model is
# configured for the backend (see ASSURE_*_MODEL_VISION); 1 forces on, 0 off. A poor picture
# (measured: too small, or blurry and low-contrast) is not sent. Bounds: pages per document,
# seconds per model call.
# PARSURE_VISION=
# PARSURE_VISION_MAX_PAGES=4
# PARSURE_VISION_TIMEOUT_S=45

# Parsure schema registry (docs/parsure-schemas.md): extra directories of
# parsure-schema-v1 JSON files, os.pathsep-separated, read after the shipped
# prompt_matrix/schemas/. A bad file is skipped with a logged reason.
# ASSURE_SCHEMA_DIR=/etc/assure/schemas

# ---- Non-Bedrock parsers (only with PARSER_BACKEND=auto or textract) ---------
# Ignored under PARSER_BACKEND=bedrock: jdf-cli and Textract cannot run there.
# PARSER_SCAN_BACKEND=jdf-ocr
# JDF_OCR=tesseract
# ASSURE_TEXTRACT_MONTHLY_USD_CAP=100
# ASSURE_TEXTRACT_MODE=analyze
