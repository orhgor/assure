# Copy to .env.production on your laptop before running scripts/aws/provision-ec2.sh
# Never commit .env.production — it is gitignored.

# Cloudflare Tunnel (written by scripts/aws/setup-tunnel.sh)
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_ID=
APP_HOST=app.getassureai.com

# Clerk (production keys)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Stripe (live or test — your choice at launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional provider keys for server-side fallbacks (BYOK is client-side in browser)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Supabase (waitlist / billing if used)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Encryption for synced keys (if enabled)
# ENCRYPTION_KEY=

# Edition
# ASSURE_EDITION=cloud
