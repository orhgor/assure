# Copy to .env.production on your laptop before running scripts/aws/provision-ec2.sh
# Never commit .env.production — it is gitignored.

# Cloudflare Tunnel (written by scripts/aws/setup-tunnel.sh)
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_ID=
APP_HOST=getassureai.com

# Clerk (production keys)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Stripe (live or test — your choice at launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional provider keys for server-side fallbacks (BYOK is client-side in browser)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Supabase (waitlist / billing if used)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Encryption for synced keys (if enabled)
# ENCRYPTION_KEY=

# Edition
# ASSURE_EDITION=cloud

# Plausible Stats API (server-side only — browser embed needs no API key)
# PLAUSIBLE_API_KEY=

# Tester help channel — Discord invite, Slack deep link, or mailto (default: mailto:feedback@getassureai.com)
# ASSURE_HELP_URL=https://discord.gg/your-invite

# Optional error tracking (server SDK + browser bundle when ENVIRONMENT=production)
# SENTRY_DSN=
# SENTRY_BROWSER_DSN=
# SENTRY_AUTH_TOKEN=   # sntrys_* — CLI/CI/source maps only; never used in SDK init

# GHCR pull on EC2 (optional if SSM redeploy passes token from your Mac / Actions)
# GHCR_USER=orhgor
# GHCR_TOKEN=   # fine-grained PAT with read:packages

# Cloudflare R2 — SQLite backups (scripts/aws/setup-sqlite-backup.sh)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_BACKUP_PREFIX=backups
# R2_BACKUP_RETAIN_DAYS=30
# R2_BACKUP_MIN_KEEP=3          # oldest kept during emergency prune
# R2_STORAGE_CAP_GB=8           # 80% of R2 free-tier 10 GB-month
# AWS_ACCESS_KEY_ID=          # R2 API token access key
# AWS_SECRET_ACCESS_KEY=      # R2 API token secret
# AWS_DEFAULT_REGION=auto
