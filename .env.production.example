# Copy to .env.production on your laptop before running scripts/aws/provision-ec2.sh
# Never commit .env.production — it is gitignored.


# ---- Infrastructure (required on every replica) ---------------------------
# PostgreSQL (RDS / Aurora Serverless v2). docker-compose.yml derives this from
# POSTGRES_* for the single-host stack; on ECS set it directly (Secrets Manager).
# DATABASE_URL=postgresql://assure:***@assure-db.xxxxx.eu-central-1.rds.amazonaws.com:5432/assure
POSTGRES_PASSWORD=
# Redis (ElastiCache). Broker, results, rate limits, debounce locks.
REDIS_URL=
# Or SQS as the broker (results then go to PostgreSQL):
# CELERY_BROKER_URL=sqs://
# CELERY_SQS_QUEUE_PREFIX=assure-
# Object storage for uploads and OMP artifacts.
ASSURE_S3_BUCKET=
ASSURE_S3_PREFIX=assure/
AWS_DEFAULT_REGION=eu-central-1
# Credentials: leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY empty here and let
# the instance/task IAM role authenticate (scripts/aws/attach-runtime-role.sh or
# the Terraform task role). If a role is not possible, the keys may be set here
# or entered once on the Sources panel (stored encrypted in PostgreSQL).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Session signing — identical on every replica.
PEM_SECRET_KEY=
# Uploads are parsed on the worker tier.
PARSE_ASYNC=1
SUBSTRATE_ASYNC_UPLOAD=1
# Scans: jdf-ocr (default, free) | textract
PARSER_SCAN_BACKEND=jdf-ocr

# Cloudflare Tunnel (written by scripts/aws/setup-tunnel.sh)
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_ID=
APP_HOST=getassureai.com

# Clerk (production keys)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Stripe (live or test — your choice at launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional provider keys for server-side fallbacks (BYOK is client-side in browser)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Supabase (waitlist / billing if used)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Encryption for synced keys (if enabled)
# ENCRYPTION_KEY=

# Edition
# ASSURE_EDITION=cloud

# Plausible Stats API (server-side only — browser embed needs no API key)
# PLAUSIBLE_API_KEY=

# Tester help channel — Discord invite, Slack deep link, or mailto (default: mailto:feedback@getassureai.com)
# ASSURE_HELP_URL=https://discord.gg/your-invite

# Optional error tracking (server SDK + browser bundle when ENVIRONMENT=production)
# SENTRY_DSN=
# SENTRY_BROWSER_DSN=
# SENTRY_AUTH_TOKEN=   # sntrys_* — CLI/CI/source maps only; never used in SDK init

# GHCR pull on EC2 (optional if SSM redeploy passes token from your Mac / Actions)
# GHCR_USER=orhgor
# GHCR_TOKEN=   # fine-grained PAT with read:packages

# Database backups: RDS automated snapshots (no file-level backup job).

# Legacy Cloudflare edge PDF worker (replaced by S3 presigned uploads —
# docs/scale_architecture.md). Keep only while the worker is still deployed.
# ASSURE_EDGE_WORKER_URL=
# SUBSTRATE_INGEST_SECRET=

# Groundrails subprocess (Python 3.12 venv on host — scripts/install-groundrails-venv.sh)
# USE_GROUNDRAILS_SERVICE=1
# GROUNDRAILS_PYTHON=/app/.venv312/bin/python

# GitHub Environments (Actions):
# STAGING_INSTANCE_ID=       # staging EC2 for branch `staging`
# ASSURE_INSTANCE_ID=        # production EC2 (optional; defaults in scripts)
