name: Source conflict badge
persona: Knowledge Worker
description: Keyword-level conflict badge opens a modal with source disagreement details.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: wait
    selector: "#jdf-render-target"
    timeout: 20000
  - action: script
    expression: |
      (() => {
        const modal = document.getElementById('source-conflict-modal');
        return modal ? 'ready' : 'missing';
      })()
  - action: assert
    condition: lastScriptResult === 'ready'
