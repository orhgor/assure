name: Sandwich surgical menu
persona: Knowledge Worker
description: Left-click a node; Ground submenu appears; History and Delete remain on the primary layer.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: unique_intent
    prefix: "Write two short paragraphs about field logistics."
  - action: click
    selector: "#generate-compile-btn"
  - action: wait_compile_ready
    timeout: 180000
  - action: click
    selector: "#generate-accept-dock"
  - action: wait
    selector: "#jdf-render-target [data-node-id]"
    timeout: 20000
  - action: click
    selector: "#jdf-render-target [data-node-id]"
    first: true
  - action: wait
    selector: "#jdf-surgical-popover:not([hidden])"
    timeout: 10000
  - action: script
    expression: |
      (() => {
        const btn = document.getElementById('surgical-ground-btn');
        const sub = document.getElementById('surgical-ground-submenu');
        const wrap = document.getElementById('surgical-ground-wrap');
        if (btn) btn.click();
        if (sub && !sub.hidden) return 'open';
        if (wrap && wrap.classList.contains('is-open')) return 'open';
        return 'closed';
      })()
  - action: assert
    condition: lastScriptResult === 'open'
  - action: assert
    selector: "#surgical-ground-auto"
  - action: assert
    selector: "#surgical-history-btn"
  - action: assert
    selector: "#surgical-delete-btn"
