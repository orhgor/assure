name: Node Revision History Modal
persona: Knowledge Worker
description: Node context menu opens revision history modal with entries.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: unique_intent
    prefix: "Write one paragraph about water purification in emergencies."
  - action: click
    selector: "#generate-compile-btn"
  - action: wait_compile_ready
    timeout: 120000
  - action: click
    selector: "#generate-accept-dock"
  - action: wait
    selector: "#jdf-render-target [data-node-id]"
    timeout: 20000
  - action: script
    expression: |
      (async () => {
        const pid = window.__ASSURE_PROJECT_ID__ || "{{projectId}}";
        const node = document.querySelector('#jdf-render-target [data-node-id]');
        const nodeId = node && node.getAttribute('data-node-id');
        if (!nodeId) return { ok: false, reason: 'no-node' };
        const jdf = await fetch(`/api/projects/${encodeURIComponent(pid)}/jdf`).then(r => r.json());
        const doc = jdf.document || {};
        const walk = (n) => {
          if (!n || typeof n !== 'object') return null;
          if (n.id === nodeId) return n;
          for (const c of (n.children || [])) {
            const hit = walk(c);
            if (hit) return hit;
          }
          return null;
        };
        let target = null;
        for (const sec of (doc.body || [])) {
          target = walk(sec);
          if (target) break;
        }
        if (!target) return { ok: false, reason: 'node-missing' };
        const updated = JSON.parse(JSON.stringify(doc));
        const patchNode = (n) => {
          if (n.id === nodeId && n.type === 'paragraph') {
            n.content = (n.content || '') + ' [history-probe]';
            return true;
          }
          for (const c of (n.children || [])) {
            if (patchNode(c)) return true;
          }
          return false;
        };
        for (const sec of (updated.body || [])) patchNode(sec);
        const put = await fetch(`/api/projects/${encodeURIComponent(pid)}/jdf`, {
          method: 'PUT',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            document: updated,
            mutation_type: 'OPENUSER_HISTORY',
            target_node_id: nodeId
          })
        });
        return { ok: put.ok, nodeId };
      })()
  - action: assert
    condition: lastScriptResult.ok === true
  - action: contextmenu
    selector: "#jdf-render-target [data-node-id]"
    first: true
  - action: wait
    selector: "#jdf-node-menu:not([hidden])"
    timeout: 5000
  - action: click
    selector: '#jdf-node-menu [data-act="history"]'
  - action: wait
    selector: "#node-revision-modal:not([hidden])"
    timeout: 10000
  - action: assert
    selector: "#node-revision-list .node-revision-item, #node-revision-list .node-revision-empty"
    visible: true
