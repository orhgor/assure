name: Z3 explanation tooltip
persona: Knowledge Worker
description: Confidence overlay shows a reason tooltip or i icon on a compiled node.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: unique_intent
    prefix: "Write a paragraph that revenue is 100 million with a matching lock."
  - action: click
    selector: "#generate-compile-btn"
  - action: wait_compile_ready
    timeout: 180000
  - action: click
    selector: "#generate-accept-dock"
  - action: wait
    selector: "#jdf-render-target [data-node-id]"
    timeout: 20000
  - action: script
    expression: |
      (() => {
        const icon = document.querySelector('.z3-reason-icon, [data-confidence-reason]');
        return icon ? 'reason' : 'missing';
      })()
  - action: assert
    condition: lastScriptResult === 'reason'
