name: Ground LLM mode
persona: Knowledge Worker
description: Ground LLM Only opens the existing diff panel for Accept/Reject.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: unique_intent
    prefix: "Write one short paragraph about warehouse safety."
  - action: click
    selector: "#generate-compile-btn"
  - action: wait_compile_ready
    timeout: 180000
  - action: click
    selector: "#generate-accept-dock"
  - action: wait
    selector: "#jdf-render-target [data-node-id]"
    timeout: 20000
  - action: click
    selector: "#jdf-render-target [data-node-id]"
    first: true
  - action: wait
    selector: "#jdf-surgical-popover:not([hidden])"
    timeout: 10000
  - action: click
    selector: "#surgical-ground-btn"
  - action: click
    selector: "#surgical-ground-llm"
  - action: wait
    selector: "#jdf-diff-panel:not([hidden])"
    timeout: 180000
