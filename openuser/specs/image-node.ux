name: Image Node Rendering
persona: Knowledge Worker
description: Image nodes persist in JDF and render a Figures section on the canvas.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: script
    expression: |
      (async () => {
        const pid = window.__ASSURE_PROJECT_ID__ || "{{projectId}}";
        const ann = { redhat: [], z3: [] };
        const pixel = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==";
        const doc = {
          document_id: "doc-openuser-image",
          meta: { title: "Image node" },
          truth_ledger: {},
          body: [{
            type: "section",
            id: "sec-ou-image",
            title: "Figures",
            children: [{
              type: "image",
              id: "img-ou-test",
              src: pixel,
              alt: "OpenUser pixel",
              caption: "Test image",
              meta: {},
              annotations: ann
            }],
            meta: {},
            annotations: ann
          }]
        };
        const put = await fetch(`/api/projects/${encodeURIComponent(pid)}/jdf`, {
          method: "PUT",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ document: doc, mutation_type: "OPENUSER_IMAGE" })
        });
        const putData = await put.json();
        if (window.__assureJdf && putData.document) {
          window.__assureJdf.tree = putData.document;
          window.__assureJdf.render();
        }
        const get = await fetch(`/api/projects/${encodeURIComponent(pid)}/jdf`, { credentials: "same-origin" });
        const getData = await get.json();
        const images = [];
        for (const sec of ((getData.document || {}).body || [])) {
          for (const child of (sec.children || [])) {
            if (child.type === "image") images.push(child.id);
          }
        }
        const canvasText = (document.getElementById("jdf-render-target") || {}).textContent || "";
        return put.ok && putData.ok !== false && images.includes("img-ou-test") && canvasText.includes("Figures");
      })()
  - action: assert
    condition: lastScriptResult === true
