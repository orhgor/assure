name: Docked Confidence Overlay
persona: Knowledge Worker
description: Confidence overlay paints on TipTap canvas after Full Audit and toggles off cleanly.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: fill
    selector: "#generate-intent"
    value: "Summarize humanitarian logistics best practices in three bullet points."
  - action: click
    selector: "#generate-full-audit-btn"
  - action: wait_audit_complete
    timeout: 180000
  - action: click
    selector: "#generate-accept-dock"
  - action: wait
    selector: "#jdf-render-target.is-tiptap, #jdf-render-target .jdf-tiptap-host"
    timeout: 20000
  - action: wait
    selector: "#confidence-overlay-wrap:not([hidden])"
    timeout: 30000
  - action: assert
    selector: "#confidence-overlay-toggle"
    visible: true
  - action: click
    selector: "#confidence-overlay-toggle"
  - action: assert
    selector: "#jdf-render-target.confidence-overlay-off"
    visible: true
