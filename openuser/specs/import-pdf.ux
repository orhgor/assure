name: Import PDF
persona: Knowledge Worker
description: Import PDF button ingests a fixture and populates the canvas.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: wait
    selector: "#jdf-import-pdf-btn"
    timeout: 15000
  - action: upload_fixture
    selector: "#jdf-import-pdf-input"
    fixture: openuser/fixtures/grounding-sample.pdf
  - action: wait
    selector: "#jdf-render-target [data-node-id]"
    timeout: 60000
  - action: assert
    selector: "#jdf-render-target [data-node-id]"
    visible: true
