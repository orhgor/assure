name: Surgical Refine Diff Viewer
persona: Knowledge Worker
description: Click-to-fix opens refine flow; diff panel when v1.1 side-by-side diff is deployed.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: unique_intent
    prefix: "Write two short paragraphs about disaster preparedness for field teams."
  - action: click
    selector: "#generate-compile-btn"
  - action: wait_compile_ready
    timeout: 180000
  - action: click
    selector: "#generate-accept-dock"
  - action: wait
    selector: "#jdf-render-target .jdf-tiptap-host, #jdf-render-target [data-node-id]"
    timeout: 20000
  - action: click
    selector: "#jdf-render-target [data-node-id]"
    first: true
  - action: wait
    selector: "#jdf-surgical-popover:not([hidden])"
    timeout: 10000
  - action: click
    selector: "#surgical-refine-ai-btn"
  - action: fill
    selector: "#surgical-refine-instruction"
    value: "Make this paragraph more neutral and concise."
  - action: submit
    selector: "#jdf-surgical-popover-form"
  - action: script
    expression: |
      (async () => {
        for (let i = 0; i < 60; i += 1) {
          const modal = document.getElementById('node-conflict-modal');
          const overwrite = document.getElementById('node-conflict-overwrite');
          if (modal && !modal.hidden && overwrite) {
            overwrite.click();
            return 'overwrite';
          }
          const panel = document.getElementById('jdf-diff-panel');
          if (panel && !panel.hidden) return 'diff';
          await new Promise((r) => setTimeout(r, 500));
        }
        return 'none';
      })()
  - action: wait_refine_result
    timeout: 240000
  - action: script
    expression: |
      (() => {
        const panel = document.getElementById('jdf-diff-panel');
        if (panel && !panel.hidden) return 'diff';
        const pop = document.getElementById('jdf-surgical-popover');
        if (pop && pop.hidden) return 'applied';
        return 'pending';
      })()
  - action: assert
    condition: lastScriptResult === 'diff' || lastScriptResult === 'applied'
