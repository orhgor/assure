name: JDF Disk Autosave
persona: Knowledge Worker
description: PUT /jdf returns disk_path and writes document.jdf on the server.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: script
    expression: |
      (async () => {
        const pid = window.__ASSURE_PROJECT_ID__ || "{{projectId}}";
        const doc = {
          document_id: "doc-openuser-autosave",
          meta: { title: "OpenUser autosave" },
          truth_ledger: {},
          body: [{
            type: "section",
            id: "sec-ou-autosave",
            title: "Autosave",
            children: [{
              type: "paragraph",
              id: "p-ou-autosave",
              content: "OpenUser disk autosave probe.",
              entities_referenced: [],
              provenance: [],
              meta: {},
              annotations: { confidence: null, redhat: [], locked: false }
            }],
            meta: {},
            annotations: { confidence: null, redhat: [], locked: false }
          }]
        };
        const res = await fetch(`/api/projects/${encodeURIComponent(pid)}/jdf`, {
          method: "PUT",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ document: doc, mutation_type: "OPENUSER_AUTOSAVE" })
        });
        const data = await res.json();
        return { ok: res.ok && data.ok !== false, disk_path: data.disk_path || "" };
      })()
  - action: assert
    condition: lastScriptResult.ok === true && lastScriptResult.disk_path.length > 0
