name: Compile Cache Experience
persona: Knowledge Worker
description: Second compile must be instant (< 1s) with cache hit.
baseUrl: https://staging.getassureai.com
steps:
  - action: navigate
    url: "{{baseUrl}}/app"
  - action: init_workbench
  - action: unique_intent
    prefix: "List three principles of effective humanitarian coordination."
  - action: wait
    selector: "#generate-compile-btn"
    timeout: 15000
  - action: measure
    id: cold_compile_ms
    steps:
      - action: click
        selector: "#generate-compile-btn"
        description: Cold compile
      - action: wait_compile_ready
        timeout: 120000
  - action: sleep
    ms: 1500
  - action: measure
    id: hot_compile_ms
    steps:
      - action: click
        selector: "#generate-compile-btn"
        description: Hot compile (cache hit)
      - action: wait_compile_ready
        timeout: 20000
  - action: assert
    condition: hot_compile_ms < 5000
  - action: assert
    condition: hot_compile_ms < cold_compile_ms * 0.5
