{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "assure-marketing-proxy",
  "main": "marketing-worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "assets": {
    // dist/ ships with the Worker as static assets; run_worker_first routes
    // every request through the Worker (redirects + contact form), which
    // delegates page delivery to the ASSETS binding.
    "directory": "../../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    // NOTE: wrangler deploy syncs triggers to exactly this list — any route NOT
    // listed here is DELETED on the next deploy. Keep every live domain here.
    // (This bit us once: dropping assureproof.com/* from the list took the site
    // down on the next successful deploy.)
    { "pattern": "getassureai.com/*", "zone_name": "getassureai.com" },
    { "pattern": "www.getassureai.com/*", "zone_name": "getassureai.com" },
    { "pattern": "assureproof.com/*", "zone_name": "assureproof.com" },
    { "pattern": "www.assureproof.com/*", "zone_name": "assureproof.com" }
  ]
}

